# Opcional. Sem .env, os valores padrão abaixo são usados.
POSTGRES_DB=spacebus
POSTGRES_USER=spacebus
POSTGRES_PASSWORD=spacebus
POSTGRES_PORT=5432
# Portas do modo desenvolvimento (lidas pelo Vite; o backend usa SERVER_PORT).
FRONTEND_PORT=5173
API_URL=http://localhost:8080
# Nome da transportadora exibido ao passageiro (piloto com uma transportadora).
SPACEBUS_TRANSPORTADORA=Transportadora piloto
# Reserva e pagamento (premissas do piloto; ver docs/modulo-03-reserva-pagamento.md).
SPACEBUS_RESERVA_BLOQUEIO_MINUTOS=10
SPACEBUS_RESERVA_CANCELAMENTO_HORAS=2
SPACEBUS_PAGAMENTO_PROVEDOR=simulado
# Tempo limite de cada chamada ao provedor e tentativas de um reembolso que falhou (depois: ação manual).
SPACEBUS_PAGAMENTO_TIMEOUT_MS=5000
SPACEBUS_REEMBOLSO_MAX_TENTATIVAS=12
# Segredo que o provedor envia no cabeçalho X-SpaceBus-Webhook-Segredo. Troque fora de dev.
SPACEBUS_WEBHOOK_SEGREDO=segredo-de-desenvolvimento
